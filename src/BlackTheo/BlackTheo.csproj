<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>BlackTheo</AssemblyName>
    <RootNamespace>Celeste.Mod.BlackTheo</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <CelesteDir Condition="'$(CelesteDir)' == ''">$(CELESTE_DIR)</CelesteDir>
    <CelesteDir Condition="'$(CelesteDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Celeste</CelesteDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\BlackHole.cso" LogicalName="Celeste.Mod.BlackTheo.BlackHole.cso" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Celeste">
      <HintPath>$(CelesteDir)\Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>$(CelesteDir)\FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MMHOOK_Celeste">
      <HintPath>$(CelesteDir)\MMHOOK_Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(CelesteDir)\MonoMod.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(CelesteDir)\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
