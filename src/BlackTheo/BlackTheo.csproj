<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CelesteMod.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <CelesteRootPath>K:\SteamLibrary\steamapps\common\Celeste</CelesteRootPath>
    <AssemblyName>BlackTheo</AssemblyName>
    <RootNamespace>Celeste.Mod.BlackTheo</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ModAssetsFolderName>..\..\dist\BlackTheo</ModAssetsFolderName>
    <ModAssetsCopyType>none</ModAssetsCopyType>
    <UseCelesteAnalyzer>true</UseCelesteAnalyzer>
    <UseCelestePublicizer>true</UseCelestePublicizer>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\BlackHole.cso" LogicalName="Celeste.Mod.BlackTheo.BlackHole.cso" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CelesteMod.props">
      <Visible>false</Visible>
    </None>
    <None Include="CelesteMod.targets">
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <Import Project="CelesteMod.targets" />
</Project>
